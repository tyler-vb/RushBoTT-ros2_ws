<?xml version='1.0'?>
<robot xmlns:xacro='http://www.ros.org/wiki/xacro'>

    <!--Arm Link-->
    <xacro:macro name='arm_link' params='name is_fake parent_link length width offset mass mesh *origin *limit'>

        <xacro:property name='arm_joint_name' value='${name}_joint'/>

        <joint name='${arm_joint_name}' type='revolute'>
            <parent link='${parent_link}'/>
            <child link='${name}'/>
            <xacro:insert_block name='origin'/>
            <xacro:insert_block name='limit'/>
            <axis xyz='0 0 1'/>
            <dynamics damping="0.1" friction="0.2"/>
        </joint>

        <link name='${name}'>
            <visual>
                <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
                <geometry>
                    <mesh filename='${mesh}' scale='0.001 0.001 0.001'/>
                </geometry>
                <xacro:insert_block name='material_orange'/>
            </visual>
            <collision>
                <origin xyz='${length/2 - offset} 0 0' rpy ='0 0 0'/>
                <geometry>
                    <box size='${length} ${width} ${width}'/>
                </geometry>
            </collision>
            <xacro:inertial_cuboid_with_pose mass='${mass}' x='${length}' y='${width}' z='${width}'>
                <origin xyz='${length/2 - offset} 0 0' rpy='0 0 0'/>
            </xacro:inertial_cuboid_with_pose>
        </link>

        <xacro:if value="$(arg is_sim)">
            <ros2_control name='${arm_joint_name}' type='system'>
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
                <joint name='${arm_joint_name}'>
                    <command_interface name='position'/>
                    <state_interface name='position'/>
                </joint>
            </ros2_control>
        </xacro:if>

        <xacro:if value="${is_fake == True}">
            <xacro:unless value="$(arg is_sim)">
                <ros2_control name='${arm_joint_name}' type='system'>
                    <hardware>
                        <plugin>mock_components/GenericSystem</plugin>
                    </hardware>
                    <joint name='${arm_joint_name}'>
                        <command_interface name='position'/>
                        <state_interface name='position'/>
                    </joint>
                </ros2_control>
            </xacro:unless>
        </xacro:if> 

    </xacro:macro> 

     <!--End Effector-->
    <xacro:macro name='end_effector' params='name parent_link length width mass mesh *origin'>

        <xacro:property name='arm_joint_name' value='${name}_joint'/>

        <joint name='${arm_joint_name}' type='fixed'>
            <parent link='${parent_link}'/>
            <child link='${name}'/>
            <xacro:insert_block name='origin'/>
        </joint>

        <link name='${name}'>
            <visual>
                <origin xyz="0 0 0" rpy="0 ${-pi/2} 0"/>
                <geometry>
                    <mesh filename='${mesh}' scale='0.001 0.001 0.001'/>
                </geometry>
                <xacro:insert_block name='material_orange'/>
            </visual>
            <collision>
                <origin xyz='${length/2} 0 0' rpy ='0 0 0'/>
                <geometry>
                    <box size='${length} ${width} ${width}'/>
                </geometry>
            </collision>
            <xacro:inertial_cuboid_with_pose mass='${mass}' x='${length}' y='${width}' z='${width}'>
                <origin xyz='${length/2} 0 0' rpy='0 0 0'/>
            </xacro:inertial_cuboid_with_pose>
        </link>

    </xacro:macro> 

</robot>