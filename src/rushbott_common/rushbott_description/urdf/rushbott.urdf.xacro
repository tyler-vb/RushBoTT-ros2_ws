<?xml version='1.0'?>
<robot xmlns:xacro='http://www.ros.org/wiki/xacro' name='rushbott'>

    <xacro:include filename='common_properties.urdf.xacro'/>
    <xacro:include filename='wheel.urdf.xacro'/>
    <xacro:include filename='wheel_with_servo.urdf.xacro'/>
    <xacro:include filename='arm.urdf.xacro'/>
    <xacro:include filename='lidar.urdf.xacro'/>

    <!-- Simulation Check-->
    <xacro:property name='is_sim'               value='False' />

    <!-- Body Properties -->
    <xacro:property name='body_mass'               value='2.300' />
    <xacro:property name='body_length'             value='${50*cm2m}' />
    <xacro:property name='body_width'              value='${30*cm2m}' />
    <xacro:property name='body_height'             value='${20*cm2m}' />

    <!--  Wheel Properties -->
    <xacro:property name='wheel_mass'              value='0.2' />
    <xacro:property name='wheel_radius'            value='${7.5*cm2m}' />
    <xacro:property name='wheel_width'             value='${5*cm2m}' />
    <xacro:property name='wheel_depth'             value='${wheel_radius}' />
    <xacro:property name='wheelbase'               value='${40*cm2m}' />
    <xacro:property name='track_width'             value='${38*cm2m}' />

    <!-- Servo Properties -->
    <xacro:property name='servo_mass'              value='0.2' />
    <xacro:property name='servo_radius'            value='${3*cm2m}' />
    <xacro:property name='servo_width'             value='${4*cm2m}' />
    <xacro:property name='servo_height'            value='${wheel_radius+3*cm2m}' />

    <!-- Arm Properties -->
    <xacro:property name='lower_arm_length'        value='${22.85*cm2m}'/>
    <xacro:property name='lower_arm_width'         value='${4.5*cm2m}'/>
    <xacro:property name='lower_arm_mass'          value='0.05'/>
    <xacro:property name='lower_arm_mesh'          value='package://rushbott_description/meshes/lower_arm.STL'/>

    <xacro:property name='upper_control_length'    value='${9.9*cm2m}'/>
    <xacro:property name='upper_control_width'     value='${2.5*cm2m}'/>
    <xacro:property name='upper_control_mass'      value='0.05'/>
    <xacro:property name='upper_control_mesh'      value='package://rushbott_description/meshes/upper_control.STL'/>

    <xacro:property name='upper_link_length'       value='${lower_arm_length}'/>
    <xacro:property name='upper_link_width'        value='${2.5*cm2m}'/>
    <xacro:property name='upper_link_mass'         value='0.05'/>
    <xacro:property name='upper_link_mesh'         value='package://rushbott_description/meshes/upper_link.STL'/>

    <xacro:property name='upper_arm_length'        value='${33.7*cm2m + upper_control_length}'/>
    <xacro:property name='upper_arm_width'         value='${3.5*cm2m}'/>
    <xacro:property name='upper_arm_mass'          value='0.05'/>
    <xacro:property name='upper_arm_mesh'          value='package://rushbott_description/meshes/upper_arm.STL'/>

    <xacro:property name='suction_base_length'     value='${2.5*cm2m}'/>
    <xacro:property name='suction_base_width'      value='${10*cm2m}'/>
    <xacro:property name='suction_base_mass'       value='0.05'/>
    <xacro:property name='suction_base_mesh'       value='package://rushbott_description/meshes/suction_base.STL'/>

    <xacro:property name='suction_head_length'     value='${1.2*cm2m}'/>
    <xacro:property name='suction_head_width'      value='${10*cm2m}'/>
    <xacro:property name='suction_head_mass'       value='0.05'/>
    <xacro:property name='suction_head_mesh'       value='package://rushbott_description/meshes/suction_head.STL'/>

    <xacro:property name='arm_x_position'          value='${32.3*cm2m - body_length/2}'/>
    <xacro:property name='arm_z_position'          value='${31.18*cm2m}'/>

    <!-- Base footprint --> 
    <link name='base_footprint'/>

    <!-- Base link --> 
    <joint name='base_footprint_to_base_link' type='fixed'>  
        <parent link='base_footprint'/>  
        <child link='base_link'/>  
        <origin xyz='0 0 ${wheel_depth+wheel_radius}'/>
    </joint>

    <link name='base_link'>
        <visual>
            <origin xyz='0 0 ${body_height/2}'/>
            <geometry>
                <box size='${body_length} ${body_width} ${body_height}'/>
            </geometry>
            <xacro:insert_block name='material_cyan'/>
        </visual>
        <collision>
            <origin xyz='0 0 ${body_height/2}'/>
            <geometry>
                <box size='${body_length} ${body_width} ${body_height}'/>
            </geometry>
        </collision>
        <xacro:inertial_cuboid_with_pose mass='${body_mass}' x='${body_length}' y='${body_width}' z='${body_height}'>
            <origin xyz='0 0 ${body_height/2}'/>
        </xacro:inertial_cuboid_with_pose>
    </link>
    
    <xacro:if value="${is_sim == True}">
        <!-- Wheels with servos -->
        <xacro:wheel_with_servo name='front_left' parent_link='base_link'>
            <origin xyz='${wheelbase/2} ${track_width/2} ${-wheel_depth+servo_height}' rpy='0 0 0'/>
            <axis xyz='0 0 1'/>
        </xacro:wheel_with_servo>

        <xacro:wheel_with_servo name='front_right' parent_link='base_link'>
            <origin xyz='${wheelbase/2} ${-track_width/2} ${-wheel_depth+servo_height}' rpy='0 0 ${pi}'/>
            <axis xyz='0 0 -1'/>
        </xacro:wheel_with_servo>

        <xacro:wheel_with_servo name='rear_left' parent_link='base_link'>
            <origin xyz='${-wheelbase/2} ${track_width/2} ${-wheel_depth+servo_height}' rpy='0 0 0'/>
            <axis xyz='0 0 1'/>
        </xacro:wheel_with_servo>

        <xacro:wheel_with_servo name='rear_right' parent_link='base_link'>
            <origin xyz='${-wheelbase/2} ${-track_width/2} ${-wheel_depth+servo_height}' rpy='0 0 ${pi}'/>
            <axis xyz='0 0 -1'/>
        </xacro:wheel_with_servo>
        
        <!-- Wheels -->
        <xacro:wheel name='mid_left' parent_link='base_link'>
            <origin xyz='0 ${track_width/2} ${-wheel_depth}' rpy='${-pi/2} 0 0'/>
            <axis xyz='0 0 1'/>
        </xacro:wheel>

        <xacro:wheel name='mid_right' parent_link='base_link'>
            <origin xyz='0 ${-track_width/2} ${-wheel_depth}' rpy='${-pi/2} 0 ${pi}'/>
            <axis xyz='0 0 -1'/>
        </xacro:wheel>
    </xacro:if>

    <!-- Arm --> 
    <xacro:arm_link name='lower_arm' is_fake='true' parent_link='base_link' length='${lower_arm_length}' width='${lower_arm_width}' mass='${lower_arm_mass}' offset='0' mesh='${lower_arm_mesh}'>
        <origin xyz='${arm_x_position} 0 ${arm_z_position}' rpy='0 0 0'/>
        <limit lower='${-100 * 26 * pi / 180}' upper='${100 * pi-0.3}' effort='10' velocity='10'/>
    </xacro:arm_link>

    <xacro:arm_link name='upper_arm' is_fake='true' parent_link='lower_arm' length='${upper_arm_length}' width='${upper_arm_width}' mass='${upper_arm_mass}' offset='${upper_control_length}' mesh='${upper_arm_mesh}'>
        <origin xyz='${-lower_arm_length} 0 0' rpy='0 0 0'/>
        <limit lower='${-pi+(21 * pi / 180) * -100}' upper='${-(21 * pi / 180) * -100}' effort='10' velocity='10'/>
    </xacro:arm_link>

    <xacro:arm_link_mimic name='upper_control' parent_link='lower_arm' length='${upper_control_length}' width='${upper_control_width}' mass='${upper_control_mass}' mesh='${upper_control_mesh}'>
        <origin xyz='0 0 0' rpy='0 0 0'/>
        <mimic joint='upper_arm_joint' multiplier='1.0'/>
    </xacro:arm_link_mimic>

    <xacro:arm_link_mimic name='upper_link' parent_link='upper_control' length='${upper_link_length}' width='${upper_link_width}' mass='${upper_link_mass}' mesh='${upper_link_mesh}'>
        <origin xyz='${-upper_control_length} 0 0' rpy='0 0 0'/>
        <mimic joint='upper_control_joint' multiplier='-1.0'/>
    </xacro:arm_link_mimic>

    <xacro:arm_link name='suction_base' is_fake='true' parent_link='upper_arm' length='${suction_base_length}' width='${suction_base_width}' mass='${suction_base_mass}' offset='0' mesh='${suction_base_mesh}'>
        <origin xyz='${-upper_control_length+upper_arm_length} 0 0' rpy='0 0 0'/>
        <limit lower='${-2*pi}' upper='${2*pi}' effort='10' velocity='10'/>
    </xacro:arm_link>

    <xacro:end_effector name='suction_head' parent_link='suction_base' length='${suction_head_length}' width='${suction_head_width}' mass='${suction_head_mass}' mesh='${suction_head_mesh}'>
        <origin xyz='${suction_base_length} 0 0' rpy='0 0 0'/>
    </xacro:end_effector>

    <!-- Lidar -->
    <xacro:lidar parent_link="base_link">
        <origin xyz="0.122 0 ${body_height}" rpy="0 0 0"/>
    </xacro:lidar>
    <!-- 
    <xacro:if value="${is_sim == False}">
        <ros2_control name="rushbott_control" type="system">
            <hardware>
                <plugin>rushbott_hardware/RoverSystemHardware</plugin>
                <param name="loop_rate">30</param>
                <param name="device">/dev/ttyACM0</param>
                <param name="baud_rate">9600</param>
                <param name="msg_attempts">10</param>
                <param name="timeout_ms">600</param>

                <param name="stepper_gear_ratio">3</param>
                <param name="stepper_enc_per_rev">400</param>
                <param name="stepper_step_per_rev">400</param>

                <param name="bldc_enc_per_rev">0</param>

            </hardware>
            <joint name="lower_arm_joint">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <param name="initial_value">0.3</param>
            </joint>
            <joint name="upper_arm_joint">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <param name="initial_value">-0.3</param>
            </joint>
        </ros2_control>
    </xacro:if> -->

        <!-- Gazebo (make this conditional later on) -->
    <xacro:if value="${is_sim == True}">
        <gazebo>
            <plugin filename='libgz_ros2_control-system.so' name='gz_ros2_control::GazeboSimROS2ControlPlugin'>
                <parameters>$(find rushbott_control)/config/control.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:if>

    

</robot>